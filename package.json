{
  "name": "greasemonkeyscripts",
  "description": "My collection of GreaseMonkey scripts",
  "version": "1.0.1",
  "type": "module",
  "private": true,
  "author": "Brice McIver",
  "license": "ISC",
  "scripts": {
    "build": "tsx src/build.ts",
    "test": "vitest run"
