    "typescript": "^5.8.3",
    "vite": "^8.0.3",
    "vite-plugin-monkey": "^7.1.4",
    "zx": "^8.8.5"
  },
  "dependencies": {
    "chessops": "^0.15.0",
    "uuid": "^13.0.0"
  },
  "packageManager": "pnpm@10.15.1"
